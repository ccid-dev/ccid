{
  "name": "ccid",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md}\"",
    "check-types": "turbo run check-types",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > apps/client/src/types/database.ts && cp apps/client/src/types/database.ts apps/admin/src/types/database.ts && prettier --write apps/*/src/types/database.ts"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-only-warn": "1.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-turbo": "2.10.12",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "1.22.22"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
