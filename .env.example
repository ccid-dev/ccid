# ─────────────────────────────────────────────────────────────
# 이 파일을 루트에 .env.local 로 복사해서 사용하세요.
#   cp .env.example .env.local
# admin / client 두 앱 모두 이 루트 env를 읽습니다. (next.config.base.mjs)
# .env.local 은 git에 올라가지 않습니다.
# ─────────────────────────────────────────────────────────────

# ─── Site / SEO (client) ─────────────────────────────────────
# canonical, sitemap, OG 이미지 절대 URL의 기준이 되는 배포 도메인 (끝 슬래시 없이)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 검색엔진 소유 확인 메타 태그 값 (선택)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ─── Analytics (client, 선택) ────────────────────────────────
# 비워두면 스크립트를 붙이지 않습니다.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# ─── Supabase ────────────────────────────────────────────────
# 로컬 개발: `yarn db:start` 실행 후 출력되는 API URL / Publishable key
# 원격: Supabase 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# admin 전용 비밀 키 (마스터의 비밀번호 재설정에 사용). NEXT_PUBLIC_ 을 붙이지 마세요.
# Supabase 대시보드 > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=

# ─── 이미지 저장소 (선택) ────────────────────────────────────
# 비워 두면 Supabase Storage 의 media 버킷을 씁니다. (따로 설정할 것 없음)
# 나중에 다른 저장소(Cloudflare R2 등)로 옮기면 그 공개 주소를 넣습니다. (끝 슬래시 없이)
# DB 에는 이미지 키만 저장하므로, 같은 키로 파일을 복사한 뒤 이 값만 바꾸면 됩니다.
NEXT_PUBLIC_MEDIA_URL=

# ─── OpenAI (선택) ─────────────────────────────────────────────
# OpenAI API 키 (선택)
OPENAI_API_KEY=
OPENAI_MODEL=

## ─── ElevenLabs (선택) ─────────────────────────────────────────────
# ElevenLabs API 키 (선택)
ELEVENLABS_API_KEY=
# ─── 보이스 에이전트 (client 서버 전용, /api/talk) ────────────
# 대답 (OpenAI). 없으면 개발 서버에서는 연습용 대답으로 동작합니다.
OPENAI_API_KEY=
# 받아 적기 · 목소리 (ElevenLabs). 목소리(한국어 · 영어)를 만든 계정의 키여야 합니다.
ELEVENLABS_API_KEY=
# 대화 통행증 서명 키. 아무 긴 임의 문자열 (예: openssl rand -hex 32). 비우면 서버를 켤 때마다 새로 만듭니다.
TALK_PASS_SECRET=
# 선택 — 비우면 기본값: gpt-6-luna · priority · none · scribe_v2 · eleven_multilingual_v2
OPENAI_AGENT_MODEL=
OPENAI_AGENT_TIER=
OPENAI_AGENT_REASONING=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
# 개발 서버에서만: 1 이면 OpenAI 를 부르지 않고 연습용 대답 (화면 작업할 때 비용 0)
TALK_FAKE=
# 사이트 전체 하루 한도 (한국 시간 기준, Supabase talk_usage 로 셈). 넘으면 "메일로 문의해 주세요"만 말합니다.
# 비우면 기본값: 대답 1000회 · 받아 적기 1500회 · 목소리 30000자
# 문의 저장 · 하루 사용량 세기에는 위 SUPABASE_SECRET_KEY 가 필요합니다. (Vercel client 프로젝트에도 넣어 주세요)
TALK_DAILY_CHATS=
TALK_DAILY_LISTENS=
TALK_DAILY_SPEAK_CHARS=
