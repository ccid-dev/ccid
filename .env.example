# ─────────────────────────────────────────────────────────────
# 이 파일을 루트에 .env.local 로 복사해서 사용하세요.
#   cp .env.example .env.local
# admin / client 두 앱 모두 이 루트 env를 읽습니다. (apps/*/next.config.js)
# .env.local 은 git에 올라가지 않습니다.
# ─────────────────────────────────────────────────────────────

# ─── Site / SEO (client) ─────────────────────────────────────
# canonical, sitemap, OG 이미지 절대 URL의 기준이 되는 배포 도메인 (끝 슬래시 없이)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 검색엔진 소유 확인 메타 태그 값 (선택)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ─── Analytics (client, 선택) ────────────────────────────────
# 비워두면 스크립트를 붙이지 않습니다.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# ─── Supabase ────────────────────────────────────────────────
# 로컬 개발: `yarn db:start` 실행 후 출력되는 API URL / Publishable key / Secret key
# 원격: Supabase 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service_role 권한 (RLS 우회) — admin 서버에서만 사용. 절대 NEXT_PUBLIC_ 으로 노출하지 마세요.
SUPABASE_SECRET_KEY=

# ─── Cloudflare R2 ───────────────────────────────────────────
# Cloudflare 대시보드 > R2 > Manage API tokens (Object Read & Write) — admin 서버에서만 사용
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 공개 버킷 URL(r2.dev) 또는 커스텀 도메인 (예: https://media.example.com)
# 업로드 결과 URL 생성 + next/image 허용 도메인으로 사용됩니다.
NEXT_PUBLIC_R2_PUBLIC_URL=
